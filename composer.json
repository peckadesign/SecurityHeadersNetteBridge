{
	"name": "pd/security-headers-nette-bridge",
	"type": "library",
	"description": "Napojení knihovny pro snadné nastavení bezpečnostních HTTP hlaviček do Nette",
	"authors": [
		{
			"name": "Milan Pála",
			"email": "milan.pala@peckadesign.cz"
		}
	],
	"require": {
		"php": "^7.4 | ^8.0",
		"pd/security-headers": "^1.2.0",
		"nette/di": "^3.0.0|^3.1.3",
		"nette/application": "^3.0"
	},
	"require-dev": {
		"nette/tester": "2.3.*",
		"pd/coding-standard": "1.27.2",
		"phpstan/phpstan": "^1.4.0"
	},
	"autoload": {
		"psr-4": {
			"Pd\\SecurityHeaders\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PdTests\\SecurityHeaders\\": "tests"
		},
		"files": [
			"tests/functions.php"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
